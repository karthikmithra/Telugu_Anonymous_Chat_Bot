# ==============================================================================
# Telegram Anon Chat Bot & Admin Console Configuration
# ==============================================================================

# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ123456789

# Database Connection URL:
# Local development default: sqlite+aiosqlite:///./anonchat.db
# Neon / Supabase PostgreSQL: postgresql+asyncpg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./anonchat.db

# Telegram Webhook URL:
# Leave blank to automatically enable Polling mode (ideal for local development).
# In production (e.g. Render): https://your-app-name.onrender.com
WEBHOOK_URL=

# Webhook Secret Token for X-Telegram-Bot-Api-Secret-Token header verification (1-256 chars: A-Z, a-z, 0-9, _, -)
WEBHOOK_SECRET=super_secret_webhook_token_1234567890

# Server Host & Port (Render dynamically assigns $PORT)
HOST=0.0.0.0
PORT=8000

# Web Admin Console HTTP Basic Auth Credentials
ADMIN_USER=admin
ADMIN_PASS=supersecretadminpass888

# Optional Telegram Private Dump Channel ID for permanent visual media archiving (e.g., -1001987654321)
MEDIA_DUMP_CHANNEL_ID=
